<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:NotepadAvalonia.Services"
        x:Class="NotepadAvalonia.Views.RecoverDraftDialog"
        Title="Recover Drafts" Width="500" Height="340"
        MinWidth="360" MinHeight="230"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="12" UseLayoutRounding="True">
    <ListBox x:Name="DraftList" AutomationProperties.Name="Drafts">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="services:DraftInfo">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyMessage" Text="No drafts are available." VerticalAlignment="Center" HorizontalAlignment="Center" />
    <StackPanel Grid.Row="1" Classes="dialog-actions">
      <Button x:Name="RestoreButton" Content="_Recover" Classes="accent" IsDefault="True" Click="OnRecover" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
