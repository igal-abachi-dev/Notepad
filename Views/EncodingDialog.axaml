<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.EncodingDialog"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Encoding">
	<StackPanel Margin="12" Spacing="12">
		<TextBlock x:Name="PromptText" />
		<ComboBox x:Name="EncodingCombo"
				  HorizontalAlignment="Stretch"
				  AutomationProperties.Name="Encoding"
				  AutomationProperties.AutomationId="EncodingOptions" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="OK" MinWidth="80" Click="OnOk" IsDefault="True" AutomationProperties.AutomationId="EncodingAccept" />
			<Button Content="Cancel" MinWidth="80" Click="OnCancel" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
