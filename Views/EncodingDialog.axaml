<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.EncodingDialog"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Encoding"
        x:CompileBindings="False">
	<StackPanel Margin="12" Spacing="12">
		<TextBlock Text="{Binding Prompt}" />
		<ComboBox x:Name="EncodingCombo"
				  ItemsSource="{Binding Options}"
				  SelectedItem="{Binding SelectedOption}"
				  HorizontalAlignment="Stretch"
				  AutomationProperties.Name="Encoding">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Name}" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="OK" MinWidth="80" Click="OnOk" IsDefault="True" />
			<Button Content="Cancel" MinWidth="80" Click="OnCancel" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
