<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.FontDialog"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Font">
  <StackPanel Margin="16" Spacing="12" UseLayoutRounding="True">
    <StackPanel>
      <Label Content="_Font" Target="{Binding #FontComboBox}" />
      <ComboBox x:Name="FontComboBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Font family" />
    </StackPanel>
    <Grid ColumnDefinitions="106,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
      <Label Content="_Size (pt)" Target="{Binding #SizeBox}" />
      <NumericUpDown x:Name="SizeBox" Grid.Row="1" Minimum="6" Maximum="144" AutomationProperties.Name="Size in points" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <CheckBox x:Name="BoldBox" Content="_Bold" />
        <CheckBox x:Name="ItalicBox" Content="_Italic" />
      </StackPanel>
    </Grid>
    <CheckBox x:Name="LigaturesBox" Content="Font _ligatures"
              ToolTip.Tip="Combine characters such as != and =&gt; when the font supports programming ligatures." />
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1" Padding="8" Height="80" ClipToBounds="True">
      <TextBlock x:Name="PreviewText" Text="AaBbYyZz 0123&#10;!=   =&gt;   -&gt;   ===" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>
    <StackPanel Classes="dialog-actions">
      <Button Content="OK" Classes="accent" Click="OnOk" IsDefault="True" />
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
