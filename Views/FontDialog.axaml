<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.FontDialog"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Font">
  <StackPanel Margin="16" Spacing="10">
    <StackPanel>
      <Label Content="_Font" Target="{Binding #FontComboBox}" />
      <ComboBox x:Name="FontComboBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Font family" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <StackPanel>
        <Label Content="_Size (pt)" Target="{Binding #SizeBox}" />
        <NumericUpDown x:Name="SizeBox" Minimum="6" Maximum="144" Width="105" AutomationProperties.Name="Size in points" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <CheckBox x:Name="BoldBox" Content="_Bold" />
        <CheckBox x:Name="ItalicBox" Content="_Italic" />
      </StackPanel>
    </StackPanel>
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1" Padding="8" Height="80" ClipToBounds="True">
      <TextBlock x:Name="PreviewText" Text="AaBbYyZz 0123" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" MinWidth="80" Click="OnOk" IsDefault="True" />
      <Button Content="Cancel" MinWidth="80" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
