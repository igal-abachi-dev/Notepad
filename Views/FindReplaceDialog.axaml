<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotepadAvalonia.ViewModels"
        x:Class="NotepadAvalonia.Views.FindReplaceDialog"
        x:DataType="vm:FindReplaceViewModel"
        Width="445"
        SizeToContent="Height"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F3" Command="{Binding RepeatDownCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding RepeatUpCommand}" />
  </Window.KeyBindings>
  <StackPanel Margin="12" Spacing="10">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
      <Label Content="_Find what:" Target="{Binding #FindTextBox}" Margin="0,0,10,6" VerticalAlignment="Center" />
      <TextBox x:Name="FindTextBox"
               Grid.Column="1"
               Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
               MinWidth="220" AutomationProperties.Name="Find what" />

      <Label Grid.Row="1" Content="Replace _with:" Target="{Binding #ReplaceTextBox}" Margin="0,0,10,0" VerticalAlignment="Center"
                 IsVisible="{Binding IsReplaceMode}" />
      <TextBox x:Name="ReplaceTextBox" Grid.Row="1"
               Grid.Column="1"
               Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
               IsVisible="{Binding IsReplaceMode}" AutomationProperties.Name="Replace with" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="16">
      <StackPanel>
        <CheckBox Content="_Match case" IsChecked="{Binding MatchCase}" />
        <CheckBox Content="Wrap _around" IsChecked="{Binding WrapAround}" />
        <CheckBox Content="Use rege_x" IsChecked="{Binding UseRegex}" />
      </StackPanel>
      <StackPanel>
        <CheckBox Content="Search _up" IsChecked="{Binding SearchUp}" IsVisible="{Binding IsFindMode}" />
        <CheckBox Content="_Whole word" IsChecked="{Binding WholeWord}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="_Find Next" Command="{Binding FindNextCommand}" MinWidth="90" IsDefault="True" />
      <Button Content="_Replace" Command="{Binding ReplaceCommand}" IsVisible="{Binding IsReplaceMode}" MinWidth="90" />
      <Button Content="Replace _All" Command="{Binding ReplaceAllCommand}" IsVisible="{Binding IsReplaceMode}" MinWidth="90" />
      <Button Content="Cancel" IsCancel="True"
              Command="{Binding CloseCommand}"
              CommandParameter="{Binding $parent[Window]}"
              MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
