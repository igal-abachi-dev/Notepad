<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotepadAvalonia.ViewModels"
        x:Class="NotepadAvalonia.Views.FindReplaceDialog"
        x:DataType="vm:FindReplaceViewModel"
        Width="460"
        SizeToContent="Height"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F3" Command="{Binding RepeatDownCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding RepeatUpCommand}" />
  </Window.KeyBindings>
  <StackPanel Margin="16" Spacing="12" UseLayoutRounding="True">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <Label Content="_Find what:" Target="{Binding #FindTextBox}" Padding="0" VerticalAlignment="Center" />
      <TextBox x:Name="FindTextBox"
               Grid.Column="1"
               Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
               MinWidth="220" AutomationProperties.Name="Find what" />

      <Label Grid.Row="1" Content="Replace _with:" Target="{Binding #ReplaceTextBox}" Padding="0" VerticalAlignment="Center"
                 IsVisible="{Binding IsReplaceMode}" />
      <TextBox x:Name="ReplaceTextBox" Grid.Row="1"
               Grid.Column="1"
               Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
               IsVisible="{Binding IsReplaceMode}" AutomationProperties.Name="Replace with" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="16">
      <StackPanel>
        <CheckBox Content="_Match case" IsChecked="{Binding MatchCase}" />
        <CheckBox Content="Wrap _around" IsChecked="{Binding WrapAround}" />
        <CheckBox Content="Use rege_x" IsChecked="{Binding UseRegex}"
                  ToolTip.Tip="Use \r, \n, or \r\n in patterns and replacements. Use \\ for a literal backslash." />
      </StackPanel>
      <StackPanel>
        <CheckBox Content="_Whole word" IsChecked="{Binding WholeWord}" />
        <CheckBox x:Name="HighlightMatchesBox" Content="High_light matches" IsChecked="{Binding HighlightMatches}" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="SearchFeedback" Text="{Binding SearchFeedback}" MinHeight="17" MaxLines="2"
               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />

    <StackPanel Classes="dialog-actions">
      <Button x:Name="FindPreviousButton" Content="Find _Previous" Command="{Binding FindPreviousCommand}"
              IsVisible="{Binding IsFindMode}" />
      <Button Content="_Find Next" Classes="accent" Command="{Binding FindNextCommand}" IsDefault="True" />
      <Button Content="_Replace" Command="{Binding ReplaceCommand}" IsVisible="{Binding IsReplaceMode}" />
      <Button Content="Replace _All" Command="{Binding ReplaceAllCommand}" IsVisible="{Binding IsReplaceMode}" />
      <Button Content="Cancel" IsCancel="True"
              Command="{Binding CloseCommand}"
              CommandParameter="{Binding $parent[Window]}" />
    </StackPanel>
  </StackPanel>
</Window>
