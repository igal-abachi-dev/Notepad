<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NotepadAvalonia.Views"
        x:Class="NotepadAvalonia.Views.PageSetupDialog"
        Title="Page Setup"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12" UseLayoutRounding="True">
    <Grid ColumnDefinitions="*,235" ColumnSpacing="20">
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel>
            <Label Content="_Paper" Target="{Binding #PaperBox}" />
            <ComboBox x:Name="PaperBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Paper size" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label Content="_Orientation" Target="{Binding #OrientationBox}" />
            <ComboBox x:Name="OrientationBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Orientation">
              <ComboBoxItem Content="Portrait" />
              <ComboBoxItem Content="Landscape" />
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Text="Margins (mm)" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <StackPanel>
            <Label Content="_Left" Target="{Binding #LeftBox}" />
            <NumericUpDown x:Name="LeftBox" Minimum="0" Maximum="500" AutomationProperties.Name="Left margin" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label Content="_Right" Target="{Binding #RightBox}" />
            <NumericUpDown x:Name="RightBox" Minimum="0" Maximum="500" AutomationProperties.Name="Right margin" />
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Label Content="_Top" Target="{Binding #TopBox}" />
            <NumericUpDown x:Name="TopBox" Minimum="0" Maximum="500" AutomationProperties.Name="Top margin" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1">
            <Label Content="_Bottom" Target="{Binding #BottomBox}" />
            <NumericUpDown x:Name="BottomBox" Minimum="0" Maximum="500" AutomationProperties.Name="Bottom margin" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <Label Content="_Header" Target="{Binding #HeaderBox}" />
          <TextBox x:Name="HeaderBox" AutomationProperties.Name="Header" />
        </StackPanel>
        <StackPanel>
          <Label Content="_Footer" Target="{Binding #FooterBox}" />
          <TextBox x:Name="FooterBox" AutomationProperties.Name="Footer" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="8">
        <TextBlock Text="Layout Preview" FontWeight="SemiBold" />
        <local:PrintPagePreview x:Name="SheetPreview" Height="262" AutomationProperties.Name="Page preview" />
        <TextBlock Text="&amp;f file, &amp;p page, &amp;d date, &amp;t time&#10;&amp;l left, &amp;c center, &amp;r right&#10;&amp;&amp; ampersand"
                   Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="Problem" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Classes="dialog-actions" HorizontalAlignment="Left">
        <Button x:Name="PrinterButton" Content="_Printer..." Click="OnPrinter" />
      </StackPanel>
      <StackPanel Grid.Column="1" Classes="dialog-actions">
        <Button Content="OK" Classes="accent" Click="OnOk" IsDefault="True" />
        <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
