<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.AboutDialog"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Icon="/Assets/notepad.ico"
        WindowStartupLocation="CenterOwner"
        Title="About Notepad">
  <StackPanel Margin="24,22,24,18" Spacing="16" UseLayoutRounding="True">
    <StackPanel Spacing="4">
      <TextBlock Text="Notepad" FontWeight="SemiBold" FontSize="26" TextAlignment="Center" />
      <TextBlock x:Name="VersionText" TextAlignment="Center" />
    </StackPanel>
    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <StackPanel Spacing="6">
      <TextBlock Text="A lightweight plain-text editor built with C# and Avalonia."
                 TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Text="© 2025 Igal Abachi" TextAlignment="Center" />
      <TextBlock Text="BSD 3-Clause license" TextAlignment="Center" />
    </StackPanel>
    <Button Content="OK" Classes="accent" Click="OnClose" IsDefault="True" IsCancel="True"
            HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            MinWidth="96" MinHeight="32" />
  </StackPanel>
</Window>
