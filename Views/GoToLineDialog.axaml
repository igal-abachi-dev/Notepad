<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.GoToLineDialog"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Go To Line">
  <StackPanel Margin="16" Spacing="12" UseLayoutRounding="True">
    <TextBlock x:Name="InfoText" AutomationProperties.AutomationId="LineRange" />
    <TextBox x:Name="LineNumberTextBox"
             AutomationProperties.Name="Line number" AutomationProperties.AutomationId="LineNumber" />
    <TextBlock x:Name="ValidationMessage" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Classes="dialog-actions">
      <Button Content="_Go To" Classes="accent" Click="OnGoTo" IsDefault="True" AutomationProperties.AutomationId="GoToAccept" />
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
