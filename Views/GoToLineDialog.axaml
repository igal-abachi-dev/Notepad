<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotepadAvalonia.Views.GoToLineDialog"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Go To Line">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock x:Name="InfoText" AutomationProperties.AutomationId="LineRange" />
    <TextBox x:Name="LineNumberTextBox"
             AutomationProperties.Name="Line number" AutomationProperties.AutomationId="LineNumber" />
    <TextBlock x:Name="ValidationMessage" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="_Go To" Click="OnGoTo" MinWidth="80" IsDefault="True" AutomationProperties.AutomationId="GoToAccept" />
      <Button Content="Cancel" Click="OnCancel" MinWidth="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
